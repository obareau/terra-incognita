{
  "name": "terra-incognita",
  "version": "0.3.0",
  "description": "Générateur de cartes procédural rétrofuturiste pour l'univers ROBOTARIIS — tiles pixel art, macros, rendu ASCII/TUI, chiptune, ancré sur l'Atlas.",
  "author": "Olivier Bareau",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "start": "tsx build.ts && electron . --no-sandbox",
    "dev": "tsx build.ts && electron . --no-sandbox",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "tsx build.ts --production && electron-builder --linux",
    "package:win": "tsx build.ts --production && electron-builder --win portable",
    "package:mac": "tsx build.ts --production && electron-builder --mac"
  },
  "build": {
    "appId": "com.robotariis.terra-incognita",
    "productName": "Terra-Incognita",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
